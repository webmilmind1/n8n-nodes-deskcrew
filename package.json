{
  "name": "n8n-nodes-deskcrew",
  "version": "1.0.5",
  "description": "n8n community node for DeskCrew, the AI helpdesk: create and read support tickets, post replies, run live chat handoffs, and publish knowledge-base and changelog entries. Usable as an AI Agent tool.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "deskcrew",
    "helpdesk",
    "help desk",
    "service desk",
    "support",
    "customer support",
    "customer service",
    "ticket",
    "tickets",
    "ticketing",
    "ticketing system",
    "live chat",
    "chat",
    "knowledge base",
    "changelog",
    "csat",
    "ai support",
    "ai helpdesk",
    "ai agent",
    "support automation"
  ],
  "license": "MIT",
  "homepage": "https://deskcrew.io",
  "author": {
    "name": "DeskCrew",
    "email": "deskcrew@inbox.deskcrew.io",
    "url": "https://deskcrew.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webmilmind1/n8n-nodes-deskcrew.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/nodes/DeskCrew dist/credentials && cp nodes/DeskCrew/deskcrew.svg nodes/DeskCrew/deskcrew.dark.svg dist/nodes/DeskCrew/ && cp nodes/DeskCrew/DeskCrew.node.json dist/nodes/DeskCrew/ && cp credentials/deskcrew.svg credentials/deskcrew.dark.svg dist/credentials/",
    "dev": "tsc --watch"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/DeskCrewApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/DeskCrew/DeskCrew.node.js"
    ],
    "strict": true
  },
  "devDependencies": {
    "n8n-workflow": "^1.70.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/webmilmind1/n8n-nodes-deskcrew/issues"
  }
}
