{
  "name": "n8n-nodes-deskcrew",
  "version": "1.0.2",
  "description": "n8n community node for DeskCrew: create and read support tickets, post replies, and publish knowledge-base and changelog entries.",
  "keywords": [
    "n8n-community-node-package",
    "deskcrew",
    "helpdesk",
    "support",
    "tickets",
    "live chat",
    "knowledge base"
  ],
  "license": "MIT",
  "homepage": "https://deskcrew.io",
  "author": {
    "name": "DeskCrew",
    "url": "https://deskcrew.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webmilmind1/n8n-nodes-deskcrew.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/nodes/DeskCrew && cp nodes/DeskCrew/deskcrew.svg dist/nodes/DeskCrew/",
    "dev": "tsc --watch"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/DeskCrewApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/DeskCrew/DeskCrew.node.js"
    ]
  },
  "devDependencies": {
    "n8n-workflow": "^1.70.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
